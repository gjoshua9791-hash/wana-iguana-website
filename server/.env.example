# Wana Iguana backend — example environment file.
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# This file contains PLACEHOLDERS ONLY — no real secrets.
#
# Two separate groups of settings:
#   * SERVER config is always read and has no database dependency.
#   * DATABASE config is read LAZILY, only when database features need it, so the
#     server and the /health endpoint start fine with none of it set.

# ----------------------------------------------------------------------------
# SERVER config (always available; no database required)
# ----------------------------------------------------------------------------
# Port the API listens on. Optional; defaults to 3001 if unset.
# Must be a valid integer 1-65535 when set — an invalid value is rejected at
# startup (the server will not silently fall back).
PORT=3001

# ----------------------------------------------------------------------------
# DATABASE config (used only by database features — added in later tasks)
#
# The /health endpoint does NOT need this: you can run `npm run dev` with
# DATABASE_URL unset and /health will still return {"ok":true}.
#
# SERVER-SIDE ONLY. Do NOT prefix with VITE_ and do NOT put this in any frontend
# env file — Vite would inline a VITE_-prefixed value into the browser bundle,
# leaking the credential. The frontend never receives DATABASE_URL.
#
# Accepts a PostgreSQL connection URL with either the `postgres://` or
# `postgresql://` scheme. Placeholder only — replace USER/PASSWORD/HOST/DATABASE
# with the real, out-of-band values in your local, git-ignored `.env`.
# ----------------------------------------------------------------------------
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
