# Wana Iguana backend — example environment file.
# Copy this file to `.env` and fill in real values. NEVER commit a real `.env`.
# This file contains PLACEHOLDERS ONLY — no real secrets.

# ----------------------------------------------------------------------------
# First milestone (Tasks A1 + A2): the /health endpoint needs NONE of these.
# You can run `npm run dev` with an empty or missing .env and /health will work.
# ----------------------------------------------------------------------------

# Port the API listens on. Optional; defaults to 3001 if unset.
PORT=3001

# ----------------------------------------------------------------------------
# Added in later tasks (Phases B–D). Not used yet; placeholders for reference.
# These are SERVER-SIDE ONLY. Do not prefix with VITE_ and do not put them in
# any frontend env file — that would ship them to the browser.
# ----------------------------------------------------------------------------

# PostgreSQL / Supabase connection string (server-side only).
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
